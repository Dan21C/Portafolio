VITE_API_URL=
VITE_USE_API=false
Supabase__Url=
Supabase__StorageBucket=apx-catalog
Auth__OtpPepper=
Auth__EnableDevelopmentOtpDisclosure=false
Email__Provider=Development
Email__FromAddress=
Email__FromName=APX
Email__ReplyToAddress=
Email__InternalRecipients__0=
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__UseStartTls=true
Email__Smtp__TimeoutSeconds=15
Email__Smtp__MaxAttempts=3
# Alternative to Smtp: set Email__Provider=Resend and configure the block below instead of Email__Smtp__*
Email__Resend__ApiKey=replace-with-server-only-secret
Email__Resend__BaseUrl=https://api.resend.com
Email__Resend__TimeoutSeconds=15
Email__Resend__MaxAttempts=3
AppUrls__AdminBaseUrl=
ProjectRequests__PrivacyPolicyVersion=2026-08
ProjectRequests__PrivacyPolicyUrl=
VITE_PRIVACY_POLICY_VERSION=2026-08
VITE_PRIVACY_POLICY_URL=
Dashboard__LeadAttentionHours=24
Dashboard__MaxRangeDays=366
Auth__CookieSameSite=Lax
Supabase__SecretKey=replace-with-server-only-secret
AppUrls__PublicBaseUrl=https://www.example.com
Proxy__KnownProxies__0=127.0.0.1
Retention__ConsumedOtpDays=7
Retention__RevokedSessionDays=30
Retention__EmailDeliveryDays=180
Retention__AuditLogDays=730
